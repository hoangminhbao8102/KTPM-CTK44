@model IEnumerable<BusBooking.Core.Entities.Schedule>
@{
    ViewBag.Title = "Tìm chuyến xe";
}

<h2>Tìm chuyến xe</h2>

<form method="get" class="row g-3 mb-3">
    <div class="col-md-3">
        <label class="form-label">Mã tuyến</label>
        <input type="number" name="routeId" value="@Context.Request.Query["routeId"]" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Ngày đi</label>
        <input type="date" name="date" value="@Context.Request.Query["date"]" class="form-control" />
    </div>
    <div class="col-md-3 align-self-end">
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Tuyến</th>
            <th>Ngày đi</th>
            <th>Giờ đi</th>
            <th>Giá vé</th>
            <th>Số ghế</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Route.Departure - @s.Route.Destination</td>
                <td>@s.DepartureDate.ToShortDateString()</td>
                <td>@s.DepartureTime</td>
                <td>@s.TicketPrice.ToString("N0") VND</td>
                <td>@s.SeatCount</td>
                <td>
                    <a class="btn btn-sm btn-info" href="@Url.Action("Details", "Schedule", new { id = s.Id })">Chi tiết</a> |
                    <a class="btn btn-sm btn-success" href="@Url.Action("Book", "Ticket", new { scheduleId = s.Id })">Đặt vé</a>
                </td>
            </tr>
        }
    </tbody>
</table>
